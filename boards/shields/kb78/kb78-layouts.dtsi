            , <&key_physical_attrs 100 100  550 200   0  0  0>  // 33 T
            , <&key_physical_attrs 100 100  650 200   0  0  0>  // 34 Y
            , <&key_physical_attrs 100 100  750 200   0  0  0>  // 35 U
            , <&key_physical_attrs 100 100  850 200   0  0  0>  // 36 I
