/*
 * KB78 の物理配列（CLAUDE.md の KLE データから生成）
 * 単位は 1u = 100
 */

#include <physical_layouts.dtsi>

/ {
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        keys  //                     w   h    x    y  rot rx ry
            = <&key_physical_attrs 100 100    0   0   0  0  0>  //  0 Esc
            , <&key_physical_attrs 100 100  150   0   0  0  0>  //  1 F1
            , <&key_physical_attrs 100 100  250   0   0  0  0>  //  2 F2
            , <&key_physical_attrs 100 100  350   0   0  0  0>  //  3 F3
            , <&key_physical_attrs 100 100  450   0   0  0  0>  //  4 F4
            , <&key_physical_attrs 100 100  550   0   0  0  0>  //  5 F5
            , <&key_physical_attrs 100 100  650   0   0  0  0>  //  6 F6
            , <&key_physical_attrs 100 100  750   0   0  0  0>  //  7 F7
            , <&key_physical_attrs 100 100  850   0   0  0  0>  //  8 F8
            , <&key_physical_attrs 100 100  950   0   0  0  0>  //  9 F9
            , <&key_physical_attrs 100 100 1050   0   0  0  0>  // 10 F10
