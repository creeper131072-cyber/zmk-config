            , <&key_physical_attrs 100 100  200 100   0  0  0>  // 16 2
            , <&key_physical_attrs 100 100  300 100   0  0  0>  // 17 3
            , <&key_physical_attrs 100 100  400 100   0  0  0>  // 18 4
            , <&key_physical_attrs 100 100  500 100   0  0  0>  // 19 5
            , <&key_physical_attrs 100 100  600 100   0  0  0>  // 20 6
            , <&key_physical_attrs 100 100  700 100   0  0  0>  // 21 7
            , <&key_physical_attrs 100 100  800 100   0  0  0>  // 22 8
            , <&key_physical_attrs 100 100  900 100   0  0  0>  // 23 9
            , <&key_physical_attrs 100 100 1000 100   0  0  0>  // 24 0
            , <&key_physical_attrs 100 100 1100 100   0  0  0>  // 25 -
