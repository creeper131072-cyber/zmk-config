            , <&key_physical_attrs 100 100  725 400   0  0  0>  // 61 N
            , <&key_physical_attrs 100 100  825 400   0  0  0>  // 62 M
            , <&key_physical_attrs 100 100  925 400   0  0  0>  // 63 ,
            , <&key_physical_attrs 100 100 1025 400   0  0  0>  // 64 .
            , <&key_physical_attrs 100 100 1125 400   0  0  0>  // 65 /
            , <&key_physical_attrs 275 100 1225 400   0  0  0>  // 66 Shift
            , <&key_physical_attrs 125 100    0 500   0  0  0>  // 67 Ctrl
            , <&key_physical_attrs 125 100  125 500   0  0  0>  // 68 Opt
            , <&key_physical_attrs 125 100  250 500   0  0  0>  // 69 Cmd
            , <&key_physical_attrs 625 100  375 500   0  0  0>  // 70 Space
            , <&key_physical_attrs 125 100 1000 500   0  0  0>  // 71 Cmd
            , <&key_physical_attrs 125 100 1125 500   0  0  0>  // 72 Opt
            , <&key_physical_attrs 100 100 1300 500   0  0  0>  // 73 Up
            , <&key_physical_attrs 100 100 1100 600   0  0  0>  // 74 Fn
            , <&key_physical_attrs 100 100 1200 600   0  0  0>  // 75 Left
            , <&key_physical_attrs 100 100 1300 600   0  0  0>  // 76 Down
            , <&key_physical_attrs 100 100 1400 600   0  0  0>  // 77 Right
            , <&key_physical_attrs 226 210  574 600   0  0  0>  // 78 Click
            ;
    };
